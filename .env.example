NEXT_PUBLIC_SITE_URL=https://nafaas.shop
NEXT_PUBLIC_API_URL=https://api.nafaas.shop
# Server-side order proxy — use your public API URL in production
BACKEND_URL=https://api.nafaas.shop
# Docker only — optional faster internal route when frontend/backend share a network
# BACKEND_INTERNAL_URL=http://nasamashop_backend:8000NEXT_PUBLIC_ORDER_PHONE_WHITELIST=055000000,0550000000
# Optional — pixels are read from backend /api/tracking/config by default.
# Only set these if you cannot reach the backend from the Next.js server at runtime.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID_2=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_ENABLE_PIXELS=
