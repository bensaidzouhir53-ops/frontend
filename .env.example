NEXT_PUBLIC_SITE_URL=https://nafaas.shop
NEXT_PUBLIC_API_URL=https://api.nafaas.shop
# Server-side order proxy — use your public API URL in production
BACKEND_URL=https://api.nafaas.shop
# Docker/Easypanel — internal backend (used first for ad redirects and server API calls)
BACKEND_INTERNAL_URL=http://nasamashop_backend:8000
NEXT_PUBLIC_ORDER_PHONE_WHITELIST=055000000,0550000000
# Optional — Meta pixel is read from backend /api/tracking/config by default.
# Only set if the Next.js server cannot reach the backend at runtime.
NEXT_PUBLIC_META_PIXEL_ID=576636091443534
ENABLE_WEB_PIXELS=true
